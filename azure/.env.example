# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_INSTANCE_NAME=        # ex. mon-instance (pour https://mon-instance.openai.azure.com)
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=          # ex. gpt-4o-mini
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=    # ex. text-embedding-3-small

# Azure AI Search
AZURE_AISEARCH_ENDPOINT=               # ex. https://mon-search.search.windows.net
AZURE_AISEARCH_KEY=                    # clé admin (l'ingestion crée l'index)
AZURE_AISEARCH_INDEX=annonces-demo-rag
AZURE_AISEARCH_QUERY_TYPE=similarity_hybrid   # ou semantic_hybrid (offre Basic et +)

# API
PORT=8787
ALLOWED_ORIGINS=https://karimtn.github.io,http://localhost:3000
